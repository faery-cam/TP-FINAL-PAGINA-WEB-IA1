<%- include('partials/head') %>

<main class="pagina-perfil-aero">

    <h1 class="titulo-perfil">
        Perfil de <%= nombre %>
    </h1>

    <!-- FILA SUPERIOR: OBRAS SUBIDAS (IZQ) | SUBIR OBRAS (DER) -->
    <div class="fila-superior-perfil">

        <!-- OBRAS SUBIDAS -->
        <section class="ventana">
            <div class="barra-ventana">
                <span class="barra-ventana-titulo">
                    Obras subidas
                    <span class="etiqueta-aero"><%= imagenes.length %></span>
                </span>
                <div class="controles-ventana" aria-hidden="true">
                    <span class="control-ventana">_</span>
                    <span class="control-ventana">□</span>
                    <span class="control-ventana">×</span>
                </div>
            </div>

            <div class="ventana-contenido">
                <div class="galeria-obras">
                    <% imagenes.forEach(imagen => { %>
                        <img src="/uploads/<%= nombre %>/<%= imagen %>"
                            alt="Obra de <%= nombre %>"
                            width="95"
                            class="imagen-aero">
                    <% }) %>
                </div>
            </div>
        </section>

        <!-- SUBIR OBRAS -->
        <section class="ventana">
            <div class="barra-ventana">
                <span class="barra-ventana-titulo">Subir obras</span>
                <div class="controles-ventana" aria-hidden="true">
                    <span class="control-ventana">_</span>
                    <span class="control-ventana">□</span>
                    <span class="control-ventana">×</span>
                </div>
            </div>

            <div class="ventana-contenido">
                <form action="/user/perfil/obras" method="POST"
                    enctype="multipart/form-data" class="form-subir-obras">

                    <input type="file" name="obras" accept="image/*"
                        multiple required class="campo-aero">

                    <button type="submit" class="boton-aero">
                        Publicar
                    </button>

                </form>

                <p class="texto-ayuda-aero">
                    Podés tener hasta 30 obras. Recomendamos subir 10 o más
                    para que la obra comunitaria se vea mejor.
                </p>
            </div>
        </section>

    </div>

    <!-- BLOQUE INFERIOR: COLLAGE + BOTONES (IZQ) | INDICACIONES (DER) -->
    <section class="ventana">
        <div class="barra-ventana">
            <span class="barra-ventana-titulo">Mi collage — Entrecapas</span>
            <div class="controles-ventana" aria-hidden="true">
                <span class="control-ventana">_</span>
                <span class="control-ventana">□</span>
                <span class="control-ventana">×</span>
            </div>
        </div>

        <div class="ventana-contenido">
            <div class="cuerpo-collage-perfil">

                <!-- COLUMNA IZQUIERDA: COLLAGE MEDIANO + BOTONES EN FILA -->
                <div class="columna-collage-botones">

                    <script type="application/json" id="datos-collage">
                        <%- JSON.stringify(imagenes.map(function(img){ return '/uploads/' + nombre + '/' + img; })) %>
                    </script>

                    <script>
                        window.URLS_IMAGENES = JSON.parse(
                            document.getElementById('datos-collage').textContent
                        );
                    </script>

                    <div class="marco-collage-mediano">
                        <div id="contenedor-collage"></div>
                    </div>

                    <div id="controles-collage" class="panel-controles-collage">
                        <button type="button" class="boton-aero" onclick="rasparCapa(1)">Capa 1</button>
                        <button type="button" class="boton-aero" onclick="rasparCapa(2)">Capa 2</button>

                        <button type="button" class="boton-aero" onclick="undo()">Deshacer</button>
                        <button type="button" class="boton-aero" onclick="redo()">Rehacer</button>
                        <button type="button" class="boton-aero" onclick="clearScratch()">Limpiar</button>

                        <button type="button" class="boton-aero" onclick="nuevoCollage()">Nuevo collage</button>
                        <button type="button" class="boton-aero" onclick="downloadCollage()">Descargar</button>

                        <button type="button" class="boton-aero" onclick="setForma('circle')">Círculo</button>
                        <button type="button" class="boton-aero" onclick="setForma('square')">Cuadrado</button>
                        <button type="button" class="boton-aero" onclick="setForma('rect')">Rectángulo</button>
                        <button type="button" class="boton-aero" onclick="setForma('oval')">Óvalo</button>
                        <button type="button" class="boton-aero" onclick="setForma('star')">Estrella</button>

                        <button type="button" class="boton-aero" onclick="pincelMenos()">Pincel −</button>
                        <button type="button" class="boton-aero" onclick="pincelMas()">Pincel +</button>

                        <button type="button" class="boton-aero" onclick="regenLayer('A')">Regenerar capa 1</button>
                        <button type="button" class="boton-aero" onclick="regenLayer('B')">Regenerar capa 2</button>
                        <button type="button" class="boton-aero" onclick="regenLayer('C')">Regenerar capa 3</button>
                    </div>

                </div>

                <!-- COLUMNA DERECHA: INDICACIONES -->
                <aside class="caja-indicaciones-collage">
                    <p>
                        <strong>Entrecapas</strong> es un collage generativo hecho con las imágenes que suben
                        los artistas de la comunidad. El programa toma tus imágenes, les recorta fragmentos,
                        texturas y figuras, los deforma y los apila en varias capas superpuestas. La gracia
                        está en lo que aparece <strong>entre las capas</strong>: no ves una imagen terminada,
                        la vas descubriendo vos.
                    </p>

                    <hr class="separador-aero">

                    <p>
                        <strong>Cómo se usa:</strong> arrastrá el mouse sobre el collage para raspar la capa
                        de arriba y dejar ver lo que hay debajo. Con los botones elegís la capa, la forma y
                        el tamaño del pincel; podés deshacer, limpiar, generar una composición nueva o
                        descargar tu versión.
                    </p>
                </aside>

            </div>
        </div>

        <script src="/p5/p5.min.js"></script>
        <script src="/p5/collage.js"></script>
    </section>

</main>

<%- include('partials/foot') %>