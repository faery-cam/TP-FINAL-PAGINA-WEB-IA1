<%- include('partials/head') %>

<main class="container max-w-xl mx-auto px-4 py-8">
    <section class="ventana">
        <div class="barra-ventana">
            <span class="barra-ventana-titulo">Crear una cuenta</span>
        </div>

        <div class="ventana-contenido">
            <h1 class="text-2xl font-bold text-blue-900 mb-5">Crear una cuenta nueva</h1>

            <form action="/user/signup" method="POST" class="flex flex-col gap-4">
                <div>
                    <label for="nombre" class="block mb-1 font-bold text-sm">Nombre de usuario:</label>
                    <input type="text" id="nombre" name="nombre" class="campo-aero" required>
                </div>

                <div>
                    <label for="email" class="block mb-1 font-bold text-sm">Correo electrónico:</label>
                    <input type="email" id="email" name="email" class="campo-aero" required>
                </div>

                <div>
                    <label for="password" class="block mb-1 font-bold text-sm">Contraseña:</label>
                    <input type="password" id="password" name="password" class="campo-aero" required>
                </div>

                <button type="submit" class="boton-aero self-start">Registrarse</button>
            </form>

            <p class="mt-5 text-sm">
                ¿Ya tenés cuenta? <a href="/user/login">Iniciá sesión acá</a> |
                <a href="/">Volver</a>
            </p>
        </div>
    </section>
</main>

<%- include('partials/foot') %>
