<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= locals.pageTitle || "Entrecapas" %>
    </title>
    <link rel="stylesheet" href="/css/output.css">
</head>

<body>
    <header style="max-width: 1020px; margin: 16px auto 0; padding: 0 16px;">
        <nav class="menu-navegacion">
            <div class="menu-links">
                <a href="/" class="menu-link">Inicio</a>
                <a href="/feed" class="menu-link">Feed</a>
                <% if (locals.usuario){%>
                    <a href="/user/perfil" class="menu-link">Mi perfil</a>
                    <a href="/user/logout" class="menu-link">Salir</a>

                    <% } else { %>
                        <a href="/#login" class="menu-link">Ingresar</a>
                        <a href="/#signup" class="menu-link">Registrarse</a>
                        <% } %>
            </div>
        </nav>
    </header>