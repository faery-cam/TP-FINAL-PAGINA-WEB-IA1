<%- include('partials/head') %>
    <main>
        <section>

            <% if (urlsObra.length>0) { %>
                <script type="application/json" id="datos-obra">
                <%- JSON.stringify(urlsObra) %>
            </script>
                <script>
                    window.URLS_IMAGENES = JSON.parse(document.getElementById('datos-obra').textContent);
                </script>

                <div id="obra-comunitaria"></div>

                <script src="/p5/p5.min.js"></script>
                <script src="/p5/colectivo.js"></script>
                <% } else { %>
                    <p>Todavía no hay obras. Se la primer persona en sumar la tuya.</p>
                    <% } %>
        </section>

        <section id="acceso">
            <h1>Entrecapas</h1>
            <p>Sumá tus imágenes a una obra colectiva que nunca queda quieta: cada aporte se mezcla con el de los demás,
                capa sobre capa.</p>
            <% if (locals.usuario) { %>
                <a href="/user/perfil">Ir a mi perfil</a>
                <% } else { %>

                    <div>
                        <button type="button" data-form="login">Ingresar</button>
                        <button type="button" data-form="signup">Registrarse</button>
                    </div>

                    <form id="login" action="/user/login" method="POST" hidden>
                        <h2>Iniciar Sesión</h2>
                        <div>
                            <label for="login-nombre">Nombre de usuario:</label><br>
                            <input type="text" id="login-nombre" name="nombre" required>
                        </div>
                        <br>
                        <div>
                            <label for="login-password">Contraseña:</label><br>
                            <input type="password" id="login-password" name="password" required>
                        </div>
                        <br>
                        <button type="submit">Ingresar</button>
                    </form>

                    <form id="signup" action="/user/signup" method="POST" hidden>
                        <h2>Crear una cuenta</h2>
                        <div>
                            <label for="signup-nombre">Nombre de usuario:</label><br>
                            <input type="text" id="signup-nombre" name="nombre" required>
                        </div>
                        <br>
                        <div>
                            <label for="signup-email">Correo electrónico:</label><br>
                            <input type="email" id="signup-email" name="email" required>
                        </div>
                        <br>
                        <div>
                            <label for="signup-password">Contraseña:</label><br>
                            <input type="password" id="signup-password" name="password" required>
                        </div>
                        <button type="submit">Registrarse</button>
                    </form>

                    <script>
                        const botones = document.querySelectorAll('[data-form]');
                        const formularios = document.querySelectorAll('#acceso form');

                        botones.forEach(boton => boton.addEventListener('click', () => mostrar(boton.dataset.form)));
                        mostrar(location.hash.slice(1));
                        window.addEventListener('hashchange', () => mostrar(location.hash.slice(1)));

                        function mostrar(id) {
                            formularios.forEach(form => form.hidden = form.id !== id);
                        }
                    </script>
                    <% } %>
        </section>
    </main>
    <%- include('partials/foot') %>