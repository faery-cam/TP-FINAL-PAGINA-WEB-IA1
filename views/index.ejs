<%- include('partials/head') %>
    <main class="pagina-perfil-aero">
        <h1 class="barra-ventana-titulo">Entrecapas</h1>
        <p>Sumá tus imágenes a una obra colectiva que nunca queda quieta: cada aporte se mezcla con el de los demás,
            capa sobre capa.</p>

        <section>

            <% if (urlsObra.length>0) { %>
                <script type="application/json" id="datos-obra">
                <%- JSON.stringify(urlsObra) %>
            </script>
                <script>
                    window.URLS_IMAGENES = JSON.parse(document.getElementById('datos-obra').textContent);
                </script>

                <div id="obra-comunitaria"></div>

                <script src="/p5/p5.min.js"></script>
                <script src="/p5/colectivo.js"></script>
                <% } else { %>
                    <p>Todavía no hay obras. Sé la primer persona en sumar la tuya.</p>
                    <% } %>
        </section>

        <section id="acceso">

            <% if (locals.usuario) { %>
                <a href="/user/perfil">Ir a mi perfil</a>
                <% } else { %>

                    <div>
                        <button type="button" data-form="login" class="boton-aero">Ingresar</button>
                        <button type="button" data-form="signup" class="boton-aero">Registrarse</button>
                    </div>

                    <form id="login" action="/user/login" method="POST" hidden
                        style="display: flex; flex-direction: column; gap: 12px;">
                        <h2 style="margin: 0; color: var(--azul-profundo);">Iniciar Sesión</h2>
                        <% if (locals.mensaje && mensaje.form==='login' ) { %>
                            <p class="etiqueta-aero">
                                <%= mensaje.texto %>
                            </p>
                            <% } %>
                                <div>
                                    <label for="login-nombre">Nombre de usuario:</label><br>
                                    <input type="text" id="login-nombre" name="nombre" required class="campo-aero">
                                </div>
                                <br>
                                <div>
                                    <label for="login-password">Contraseña:</label><br>
                                    <input type="password" id="login-password" name="password" required
                                        class="campo-aero">
                                </div>
                                <br>
                                <button type="submit">Ingresar</button>
                    </form>

                    <form id="signup" action="/user/signup" method="POST" hidden>
                        <h2 class="barra-ventana-titulo">Crear una cuenta</h2>
                        <% if (locals.mensaje && mensaje.form==='signup' ) { %>
                            <p>
                                <%= mensaje.texto %>
                            </p>
                            <% } %>
                                <div>
                                    <label for="signup-nombre" class="block mb-1 font-bold text-sm">Nombre de
                                        usuario:</label><br>
                                    <input type="text" id="signup-nombre" name="nombre" required>
                                </div>
                                <br>
                                <div>
                                    <label for="signup-email" class="block mb-1 font-bold text-sm">Correo
                                        electrónico:</label><br>
                                    <input type="email" id="signup-email" name="email" required>
                                </div>
                                <br>
                                <div>
                                    <label for="signup-password"
                                        class="block mb-1 font-bold text-sm">Contraseña:</label><br>
                                    <input type="password" id="signup-password" name="password" required>
                                </div>
                                <button type="submit" class="boton-aero self-start">Registrarse</button>
                    </form>

                    <script>
                        const botones = document.querySelectorAll('[data-form]');
                        const formularios = document.querySelectorAll('#acceso form');

                        botones.forEach(boton => boton.addEventListener('click', () => mostrar(boton.dataset.form)));
                        mostrar(location.hash.slice(1));
                        window.addEventListener('hashchange', () => mostrar(location.hash.slice(1)));

                        function mostrar(id) {
                            formularios.forEach(form => form.hidden = form.id !== id);
                        }
                    </script>
                    <% } %>
        </section>
    </main>
    <%- include('partials/foot') %>