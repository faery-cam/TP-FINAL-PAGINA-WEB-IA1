<%- include('partials/head') %>
    <main>
        <section>
            <h1>Entrecapas</h1>
            <p>Sumá tus imágenes a una obra colectiva que nunca queda quieta: cada aporte se mezcla con el de los demás,
                capa sobre capa.</p>
            <% if (locals.usuario) { %>
                <a href="/user/perfil">Ir a mi perfil</a>
                <% } else { %>
                    <a href="/user/signup">Sumate</a>
                    <a href="/user/login">Ya tengo cuenta</a>
                    <% } %>
        </section>
        <main class="container" style="max-width: 400px; margin: 50px auto;">
            <h2>Iniciar Sesión</h2>
            <form action="/user/login" method="POST">
                <div>
                    <label for="nombre">Nombre de usuario:</label><br>
                    <input type="text" id="nombre" name="nombre" required>
                </div>
                <br>
                <div>
                    <label for="password">Contraseña:</label><br>
                    <input type="password" id="password" name="password" required>
                </div>
                <br>
                <button type="submit">Ingresar</button>
            </form>
            <p style="margin-top: 20px;">
                ¿No tenés cuenta? <a href="/user/signup">Registrate acá</a> | <a href="/">Volver</a>
            </p>

            <section>
                <script type="application/json" id="datos-obra">
                <%- JSON.stringify(locals.urlsObra || []) %>
            </script>
                <script>
                    window.URLS_IMAGENES = JSON.parse(document.getElementById('datos-obra').textContent);
                </script>

                <div id="obra-comunitaria"></div>

                <script src="/p5/p5.min.js"></script>
                <script src="/p5/colectivo.js"></script>
            </section>
        </main>
        <%- include('partials/foot') %>