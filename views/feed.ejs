<%- include('partials/head') %>
    <main class="container mx-auto px-4 py-8">
        <h1 class="barra-ventana-titulo">Feed</h1>
        <% if (obras.length===0) { %>
            <p>Todavía no hay obras para mostrar.</p>
            <% } %>
                <section id="feed">
                    <% obras.forEach(obra=> { %>
                        <a href="/user/<%= obra.user %>">
                            <img src="<%= obra.url %>" alt="Obra de <% obra.nombreVisible %>" width="300">
                            <span>
                                <%= obra.nombreVisible %> @<%= obra.user %>
                            </span>
                        </a>
                        <% }) %>
                </section>
    </main>
    <%- include('partials/foot') %>