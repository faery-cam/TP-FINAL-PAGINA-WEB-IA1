
<%- include('partials/head') %>

<main class="container mx-auto px-4 py-8 flex flex-col gap-8">

    <section class="ventana">
        <div class="barra-ventana">
            <span class="barra-ventana-titulo"> Entrecapas</span>

        </div>

        <div class="ventana-contenido text-center">
            <h1 class="text-3xl font-bold text-[var(--azul-xp)] mb-3">
                Inicie su cuenta
            </h1>

            <p class="max-w-2xl mx-auto mb-5">
                ¿Ya tenés cuenta? Ingrese sus datos para verificar la información.
            </p>

        </div>
    </section>

    <section class="ventana max-w-md w-full mx-auto">
        <div class="barra-ventana">
            <span class="barra-ventana-titulo">🔐 Iniciar sesión</span>
         
        </div>

        <div class="ventana-contenido">

            <h2 class="text-2xl font-bold mb-5 text-center">
                Iniciar Sesión
            </h2>

            <form action="/user/login" method="POST" class="flex flex-col gap-4">

                <div>
                    <label for="nombre" class="block mb-1 text-sm font-bold">
                        Nombre de usuario:
                    </label>
                    <input type="text" id="nombre" name="nombre" class="campo-aero" required>
                </div>

                <div>
                    <label for="password" class="block mb-1 text-sm font-bold">
                        Contraseña:
                    </label>
                    <input type="password" id="password" name="password" class="campo-aero" required>
                </div>

                <button type="submit" class="boton-aero self-center mt-2">
                    Ingresar
                </button>

            </form>

            <p class="mt-5 text-sm text-center">
                ¿No tenés cuenta? <a href="/user/signup">Registrate acá</a> |
                <a href="/">Volver</a>
            </p>

        </div>
    </section>

    <section class="ventana">
        <div class="barra-ventana">
            <span class="barra-ventana-titulo">🖼️ Obra comunitaria</span>
          
       
        </div>

        <div class="ventana-contenido">

            <script type="application/json" id="datos-obra">
                <%- JSON.stringify(locals.urlsObra || []) %>
            </script>

            <script>
                window.URLS_IMAGENES = JSON.parse(document.getElementById('datos-obra').textContent);
            </script>

            <div id="obra-comunitaria" class="w-full overflow-hidden rounded-lg"></div>

            <script src="/p5/p5.min.js"></script>
            <script src="/p5/colectivo.js"></script>

        </div>
    </section>

</main>

<%- include('partials/foot') %>
