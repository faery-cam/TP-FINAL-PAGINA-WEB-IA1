<div>
    <% if (profile.picture) { %>
        <img src="/uploads/profileAvatar/<%= profile.picture %>" alt="Foto de perfil de <%= nombre %>" width="120">
        <% } else { %>
            <div aria-hidden="true"></div>
            <% } %>
                <h1 class="titulo-perfil">
                    <%= profile.visible_name %>
                </h1>
                <p>@<%= nombre %>
                </p>
                <% if (profile.bio) { %>
                    <p>
                        <%= profile.bio %>
                    </p>
                    <% } %>
                        <% if (logueado) { %>
                            <% if (view==='config' ) { %>
                                <a href="/user/perfil">Volver al perfil</a>
                                <% } else { %>
                                    <a href="/user/perfil?view=config">Editar perfil</a>
                                    <% } %>
                                        <% } %>
</div>