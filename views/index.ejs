<%- include('partials/head') %>
    <main class="container mx-auto px-4 py-8 flex flex-col gap-8">
        <section class="ventana">
              <div class="ventana-contenido text-center">
            <h1 class="text-4xl font-bold text-[var(--azul-xp)] mb-4">Entrecapas </h1>
            <p class="max-w-2xl mx-auto mb-6 text-[var(--azul-oscuro)]">Sumá tus imágenes a una obra colectiva que nunca queda quieta: cada aporte se mezcla con el de los demás, capa sobre capa.</p>
            <% if (locals.usuario) { %>
                <a href="/user/perfil" class="boton-aero">Ir a mi perfil</a>
            <% } else { %>
                <a href="/user/signup" class="boton-aero">Sumate</a>
                <a href="/user/login" class="boton-aero">Ya tengo cuenta</a>
            <% } %>
        </div>
        </section>

        <section class="ventana">
              <div class="ventana-contenido">
            <script type="application/json" id="datos-obra">
                <%- JSON.stringify(urlsObra) %>
            </script>
            <script>
                window.URLS_IMAGENES = JSON.parse(document.getElementById('datos-obra').textContent);
            </script>

            <div id="obra-comunitaria" class="w-full overflow-hidden rounded-lg"></div>

            <script src="/p5/p5.min.js"></script>
            <script src="/p5/colectivo.js"></script>
        </section>
    </div>
    </main>
    <%- include('partials/foot') %>