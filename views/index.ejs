<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Registro y Subida de Archivos</title>
    <style>

    </style>
</head>
<!--comentario-->
<body>
    <div class="container">
        <h2>Formulario de Registro y Carga de Archivos</h2>
        <form action="/upload" method="POST" enctype="multipart/form-data">
            
            <fieldset>
                <legend>Datos Personales</legend>
                <label for="nombre">Nombre Completo:</label>
                <input type="text" id="nombre" name="nombre" required>

                <label for="email">Correo Electrónico:</label>
                <input type="email" id="email" name="email" required>

                <label for="edad">Edad:</label>
                <input type="number" id="edad" name="edad">
            </fieldset>

            <fieldset>
                <legend>Carga de Obras</legend>
                <label for="archivo1">Obra1 :</label>
                <input type="file" id="archivo1" name="archivo1" required>

                <label for="archivo2">Obra 2:</label>
                <input type="file" id="archivo2" name="archivo2" required>

                <label for="archivo3">Obra3:</label>
                <input type="file" id="archivo3" name="archivo3" required>
            </fieldset>

            <button type="submit">Enviar Formulario</button>
        </form>
    </div>
</body>
</html>
